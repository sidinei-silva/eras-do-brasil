{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Executar Air",
      "type": "shell",
      "command": "air",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "building...",
          "endsPattern": "API server listening"
        }
      }
    }
  ]
}
