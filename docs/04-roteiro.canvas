   "text": "- Tela de login e de personagem simples",
   "x": 1160,
   "y": 400,
   "width": 280,
   "height": 200
  },
  {
   "id": "rtc4100000000000",
   "type": "text",
   "text": "- Greybox da Beira\n- Inventário, craft e reparo",
   "x": 1480,
   "y": 400,
   "width": 280,
   "height": 200
  },
  {
